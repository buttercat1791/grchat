{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "GRCHAT_CONFIG='./grchat.dev.yaml' vite",
    "build": "GRCHAT_CONFIG='./grchat.yaml' vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "prerequisites": "./install-noscrypt.sh"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/cache": "jsr:@std/cache@^0.2.1",
    "@std/http": "jsr:@std/http@^1.0.22",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@std/uuid": "jsr:@std/uuid@^1.0.9",
    "@std/yaml": "jsr:@std/yaml@^1.0.10",
    "@valkey/valkey-glide": "npm:@valkey/valkey-glide@^2.2.1",
    "daisyui": "npm:daisyui@^5.5.14",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.5.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "vite": "npm:vite@^7.3.0",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
    "zod": "npm:zod@^4.2.1",
    "@paulmillr/qr": "jsr:@paulmillr/qr@^0.5.3",
    "cuer": "npm:cuer@^0.0.3"
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "unstable": ["kv"]
}
